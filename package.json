{
  "name": "slot-text-native",
  "version": "0.1.0",
  "description": "Slot-machine text roll animations for React Native and Expo, driven by a single Reanimated clock.",
  "keywords": [
    "react-native",
    "expo",
    "reanimated",
    "animation",
    "text",
    "text-roll",
    "slot-machine",
    "counter",
    "odometer",
    "ticker"
  ],
  "homepage": "https://gitlab.com/soundsystems/slot-text-native",
  "bugs": {
    "url": "https://gitlab.com/soundsystems/slot-text-native/-/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/soundsystems/slot-text-native.git"
  },
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "react-native": "./src/index.tsx",
      "import": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "source": "./src/index.tsx",
  "react-native": "./src/index.tsx",
  "types": "./lib/typescript/commonjs/index.d.ts",
  "files": [
    "lib",
    "src",
    "!**/__tests__",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bob build",
    "clean": "rm -rf lib",
    "format": "biome check --write .",
    "lint": "biome check .",
    "prepare": "bob build",
    "prepublishOnly": "bun run lint && bun run typecheck && bun run test && bun run build",
    "test": "bun test --preload ./src/__tests__/setup.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/bun": "^1.3.14",
    "@types/react": "~19.2.2",
    "@types/react-test-renderer": "19.1.0",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-builder-bob": "^0.43.0",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.9.2",
    "ultracite": "^7.10.5"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-native": ">=0.78.0",
    "react-native-reanimated": ">=4.0.0"
  },
  "packageManager": "pnpm@11.21.0",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
